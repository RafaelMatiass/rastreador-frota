// Regras do Cloud Firestore do TrakSync (Rastreador de Frota).
// Aplicar em: Console do Firebase > Firestore Database > Regras (colar e publicar).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ehControlador() {
      return logado() && meuPerfil().perfil == 'CONTROLADOR';
    }

    function camposAlterados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // "usuarios/{uid}" é o único registro de cada usuário (inclusive do motorista).
    match /usuarios/{uid} {
      // Cada um lê o próprio perfil; o controlador lê os motoristas.
      allow read: if logado() &&
        (request.auth.uid == uid || (ehControlador() && resource.data.perfil == 'MOTORISTA'));

      // Cadastro: só o próprio usuário, sempre ativo e sem veículo associado.
      allow create: if logado() && request.auth.uid == uid &&
        request.resource.data.perfil in ['MOTORISTA', 'CONTROLADOR'] &&
        request.resource.data.ativo == true &&
        !('veiculoRemoteId' in request.resource.data);

      // O usuário edita os próprios dados cadastrais; perfil, email, veículo e
      // status não. O controlador altera SÓ veículo e status dos motoristas.
      allow update: if logado() && (
        (request.auth.uid == uid &&
          !camposAlterados().hasAny(['perfil', 'email', 'ativo', 'veiculoRemoteId'])) ||
        (ehControlador() && resource.data.perfil == 'MOTORISTA' &&
          camposAlterados().hasOnly(['ativo', 'veiculoRemoteId']))
      );

      allow delete: if false;
    }

    // Veículos: o gestor faz tudo. O motorista cadastra como PENDENTE (vai para
    // aprovação), edita o que ele mesmo propôs enquanto pendente, e no veículo
    // atribuído a ele só registra a vistoria e dados de uso.
    match /veiculos/{id} {
      allow read: if logado();

      allow create: if ehControlador() || (logado() &&
        request.resource.data.situacao == 'PENDENTE' &&
        request.resource.data.cadastradoPorUid == request.auth.uid);

      allow update: if ehControlador() || (logado() && (
        (resource.data.cadastradoPorUid == request.auth.uid &&
          resource.data.situacao == 'PENDENTE' &&
          request.resource.data.situacao == 'PENDENTE') ||
        (meuPerfil().veiculoRemoteId == id &&
          camposAlterados().hasOnly(['modelo', 'capacidadeCargaKg', 'odometroKm',
            'ultimaVistoriaEm', 'observacoes', 'updatedAt']))
      ));

      allow delete: if false; // exclusão é lógica (campo "removido"), feita pelo gestor
    }

    // Cercas (geofencing, Entrega 8): todos leem (o aparelho do motorista registra
    // as cercas reais); só o gestor cria, altera e exclui.
    match /cercas/{id} {
      allow read: if logado();
      allow write: if ehControlador();
    }

    // Alertas vindos do GPS real do motorista: ele cria os dele; o gestor lê todos.
    match /alertas/{id} {
      allow create, update: if logado() && request.resource.data.uid == request.auth.uid;
      allow read: if ehControlador() || (logado() && resource.data.uid == request.auth.uid);
      allow delete: if false;
    }
  }
}
